// GrokBok — Prisma schema
// Real product: every account (User) owns its own bots, chats, memories,
// routines and tool connections. No shared or demo data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  company      String       @default("")
  passwordHash String
  bots         Bot[]
  threads      Thread[]
  connections  Connection[]
  createdAt    DateTime     @default(now())
}

model Connection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("api_key") // api_key | webhook | email | database | custom
  config    String   @default("{}") // JSON string: { value?, url?, notes? }
  createdAt DateTime @default(now())
}

model Bot {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  role      String
  emoji     String    @default("🤖")
  persona   String    @default("")
  status    String    @default("idle") // idle | working | waiting_approval
  memories  Memory[]
  routines  Routine[]
  createdAt DateTime  @default(now())
}

model Thread {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  isGroup   Boolean   @default(false)
  botIds    String    @default("[]") // JSON string[] of bot ids
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Message {
  id             String   @id @default(cuid())
  threadId       String
  thread         Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role           String // user | bot
  botId          String?
  content        String
  activity       String   @default("[]") // JSON ActivityStep[]
  needsApproval  Boolean  @default(false)
  approvalStatus String   @default("none") // none | pending | approved | rejected
  approvalNote   String   @default("")
  createdAt      DateTime @default(now())
}

model Memory {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  content   String
  source    String   @default("chat") // chat | teaching | user
  createdAt DateTime @default(now())
}

model Routine {
  id        String    @id @default(cuid())
  botId     String
  bot       Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  title     String
  schedule  String
  steps     String    @default("[]") // JSON string[]
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
}
