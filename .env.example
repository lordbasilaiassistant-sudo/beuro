# --- database -------------------------------------------------------------
# SQLite by default. Path is relative to the prisma/ directory at runtime,
# so `../db/custom.db` here resolves to <repo>/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# --- auth -----------------------------------------------------------------
# Any long random string. Sessions are signed with it.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- AI inference ---------------------------------------------------------
# Beuro needs NO API key on its default rail.
#
# LLM_PROVIDER=glm  (default) — keyless free chat via a Z.ai-hosted Web Dev
#   SDK deployment. The platform supplies model access. It is a preview
#   domain on a shared quota, so it rotates and it is SERIAL: never fan out.
LLM_PROVIDER="glm"
GLM_BASE="https://k1y9z7g5f8m0-d.space-z.ai"

# LLM_PROVIDER=openai — any OpenAI-compatible /chat/completions endpoint:
#   Z.ai paid, Groq, OpenRouter, Ollama, vLLM, OpenAI itself.
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.z.ai/api/paas/v4"
# LLM_MODEL="glm-4-flash"
# LLM_API_KEY=""

# --- failover ---------------------------------------------------------------
# An agent loop makes several model calls per task, which is the load that
# rate-limits the keyless rail deployment-wide. Backoff cannot fix that (the
# limit is not ours to wait out), so configure a SECOND free rail and Beuro
# switches to it automatically on a rate limit.
#
# On z.ai only glm-4.5-flash is free without balance — the rest return
# "1113 Insufficient balance". It is ~7x slower than the keyless rail, which is
# why it is the fallback rather than the default.
# LLM_FALLBACK_BASE_URL="https://api.z.ai/api/paas/v4"
# LLM_FALLBACK_MODEL="glm-4.5-flash"
# LLM_FALLBACK_API_KEY=""

# Floor gap in ms between LLM calls (shared-quota politeness).
# LLM_MIN_GAP_MS="400"

# --- metering -----------------------------------------------------------------
# Turns included per user per month. A "turn" is one user message, which runs up
# to 5 model calls plus whatever tools it needs.
#
# Measured 2026-08-30 on Workers AI: ~809 neurons per turn, $0.0089 beyond the
# free allowance — and that free allowance (10,000 neurons/day) is ACCOUNT-WIDE,
# roughly 12 turns a day shared by everyone. So if you open an instance to other
# people, set this. Left at 0 (the default) metering is off entirely, which is
# what you want when you are the only user.
# MONTHLY_TURN_LIMIT="0"

# Accounts never metered, comma-separated. Yours.
# OWNER_EMAILS="you@example.com"
