# --- database -------------------------------------------------------------
# SQLite by default. Path is relative to the prisma/ directory at runtime,
# so `../db/custom.db` here resolves to <repo>/db/custom.db.
DATABASE_URL="file:../db/custom.db"

# --- auth -----------------------------------------------------------------
# Any long random string. Sessions are signed with it.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- AI inference ---------------------------------------------------------
# Beuro needs NO API key on its default rail.
#
# LLM_PROVIDER=glm  (default) — keyless free chat via a Z.ai-hosted Web Dev
#   SDK deployment. The platform supplies model access. It is a preview
#   domain on a shared quota, so it rotates and it is SERIAL: never fan out.
LLM_PROVIDER="glm"
GLM_BASE="https://k1y9z7g5f8m0-d.space-z.ai"

# LLM_PROVIDER=openai — any OpenAI-compatible /chat/completions endpoint:
#   Z.ai paid, Groq, OpenRouter, Ollama, vLLM, OpenAI itself.
# LLM_PROVIDER="openai"
# LLM_BASE_URL="https://api.z.ai/api/paas/v4"
# LLM_MODEL="glm-4-flash"
# LLM_API_KEY=""

# Floor gap in ms between LLM calls (shared-quota politeness).
# LLM_MIN_GAP_MS="400"
